<Page
    x:Class="BorealBoost.App.Pages.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BorealBackgroundBrush}" Padding="32">
        <ScrollViewer>
            <StackPanel Spacing="24" MaxWidth="1120">
                <StackPanel Spacing="8">
                    <TextBlock Text="Restauracao" Style="{StaticResource BorealDisplayTextBlockStyle}" />
                    <TextBlock Text="Foundation de recovery e rollback baseada em sessoes, journal e OperationSnapshot." Style="{StaticResource BorealBodyTextBlockStyle}" />
                </StackPanel>

                <Border Style="{StaticResource BorealCardBorderStyle}">
                    <StackPanel Margin="24" Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Atualizar" Click="OnRefreshClick" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource BorealBodyTextBlockStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Sessoes com estado reversivel" Style="{StaticResource BorealHeadingTextBlockStyle}" />
                <ListView ItemsSource="{Binding Sessions}" MaxHeight="320">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.7*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SessionId}" Foreground="{StaticResource BorealTextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding State}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding StartedAtUtc}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="{Binding CompletedAtUtc}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                                <TextBlock Grid.Column="4" Text="{Binding SnapshotItems}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                                <TextBlock Grid.Column="5" Text="{Binding RollbackStatus}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Recovery" Style="{StaticResource BorealHeadingTextBlockStyle}" />
                <ListView ItemsSource="{Binding RecoveryCandidates}" MaxHeight="260">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.7*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SessionId}" Foreground="{StaticResource BorealTextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding State}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding SuggestedAction}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="{Binding Reason}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
