<Page
    x:Class="BorealBoost.App.Pages.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BorealBackgroundBrush}" Padding="32">
        <Border Style="{StaticResource BorealCardBorderStyle}" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Margin="24" Spacing="12">
                <TextBlock Text="{Binding Title}" Style="{StaticResource BorealDisplayTextBlockStyle}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                <TextBlock Text="Placeholder profissional da Foundation. Funcionalidade real sera entregue na fase correspondente do roadmap." Style="{StaticResource BorealBodyTextBlockStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
