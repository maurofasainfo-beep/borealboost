<Page
    x:Class="BorealBoost.App.Pages.OptimizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BorealBackgroundBrush}" Padding="32">
        <ScrollViewer>
            <StackPanel Spacing="24" MaxWidth="1120">
                <StackPanel Spacing="8">
                    <TextBlock Text="Otimizacao" Style="{StaticResource BorealDisplayTextBlockStyle}" />
                    <TextBlock Text="Review Plan e Dry Run do motor transacional. A Fase 4 nao aplica catalogo de performance." Style="{StaticResource BorealBodyTextBlockStyle}" />
                </StackPanel>

                <Border Style="{StaticResource BorealCardBorderStyle}">
                    <StackPanel Margin="24" Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Dry Run" Click="OnDryRunClick" IsEnabled="{Binding CanDryRun}" />
                            <Button Grid.Column="1" Content="Confirmar prova controlada" Click="OnExecuteControlledClick" IsEnabled="{Binding CanExecuteControlledOperation}" />
                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource BorealBodyTextBlockStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding PlanSummary}" Foreground="{StaticResource BorealTextPrimaryBrush}" FontSize="16" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SafetySummary}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                        <TextBlock Text="{Binding ExecutionSummary}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Operacoes planejadas" Style="{StaticResource BorealHeadingTextBlockStyle}" />
                <ListView ItemsSource="{Binding Operations}" MaxHeight="260">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding OperationId}" Foreground="{StaticResource BorealTextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding OperationType}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding Target}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="{Binding ChangeStatus}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                                <TextBlock Grid.Column="4" Text="{Binding SnapshotStatus}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                                <TextBlock Grid.Column="5" Text="{Binding Reversibility}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Safety validation" Style="{StaticResource BorealHeadingTextBlockStyle}" />
                <ListView ItemsSource="{Binding Issues}" MaxHeight="260">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Code}" Foreground="{StaticResource BorealTextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding Scope}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource BorealBodyTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
